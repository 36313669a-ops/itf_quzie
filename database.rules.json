{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "questions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "games": {
      "$code": {
        ".read": false,
        ".write": false,
        "public": {
          ".read": true,
          ".write": false
        }
      }
    },
    "gamePrivate": {
      "$code": {
        ".read": false,
        ".write": false
      }
    }
  }
}
